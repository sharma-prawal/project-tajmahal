{
  "name": "project-tajmahal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "content:lint": "tsx scripts/content-pipeline/content-lint.ts",
    "capture:bakeoff": "tsx scripts/capture-bakeoff.ts",
    "capture:lighting": "tsx scripts/capture-lighting.ts",
    "capture:charbagh": "tsx scripts/capture-charbagh.ts",
    "capture:vegetation": "tsx scripts/capture-vegetation.ts",
    "capture:water": "tsx scripts/capture-water.ts",
    "capture:atmosphere": "tsx scripts/capture-atmosphere.ts",
    "capture:ambient": "tsx scripts/capture-ambient.ts",
    "capture:audio": "tsx scripts/capture-audio.ts",
    "capture:composition": "tsx scripts/capture-composition.ts",
    "capture:traversal": "tsx scripts/capture-traversal.ts",
    "capture:exploration": "tsx scripts/capture-exploration-overhaul.ts",
    "capture:environment-premium": "tsx scripts/capture-environment-premium.ts",
    "capture:phase8c": "tsx scripts/capture-phase8c.ts",
    "capture:interaction": "tsx scripts/capture-interaction.ts",
    "capture:memory-runtime": "tsx scripts/capture-memory-runtime.ts",
    "capture:memory-mints": "tsx scripts/capture-memory-mints.ts",
    "capture:memory-back": "tsx scripts/capture-memory-back.ts",
    "capture:memory-umbrella": "tsx scripts/capture-memory-umbrella.ts",
    "capture:memory-little-details": "tsx scripts/capture-memory-little-details.ts",
    "capture:memory-all-day-call": "tsx scripts/capture-memory-all-day-call.ts && tsx scripts/capture-memory-all-day-call-little-details-regression.ts",
    "capture:memory-boarding-passes": "tsx scripts/capture-memory-boarding-passes.ts && tsx scripts/capture-memory-boarding-passes-regressions.ts",
    "capture:memory-friday-night": "tsx scripts/capture-memory-friday-night.ts && tsx scripts/capture-memory-friday-night-regressions.ts",
    "capture:bridge-candidates": "tsx scripts/capture-bridge-candidates.ts",
    "capture:canonical-journey": "tsx scripts/capture-canonical-journey.ts",
    "benchmark:render": "tsx scripts/benchmark-render.ts",
    "benchmark:memory-boarding-passes": "tsx scripts/benchmark-memory-boarding-passes.ts",
    "benchmark:memory-friday-night": "tsx scripts/benchmark-memory-friday-night.ts"
  },
  "dependencies": {
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.10",
    "@react-three/rapier": "^1.5.0",
    "framer-motion": "^11.11.17",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.4.1",
    "@gltf-transform/core": "^4.4.1",
    "@gltf-transform/extensions": "^4.4.1",
    "@gltf-transform/functions": "^4.4.1",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.14",
    "gltf-validator": "2.0.0-dev.3.10",
    "meshoptimizer": "^1.2.0",
    "playwright": "^1.61.1",
    "prettier": "^3.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-tsconfig-paths": "^5.1.0",
    "vitest": "^1.6.1"
  }
